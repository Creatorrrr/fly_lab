        with p.open("xb") as stream:
            stream.flush();os.fsync(stream.fileno())
        streams[label] = {"path": p.relative_to(root).as_posix(), "bytes": 0, "sha256": hashlib.sha256(b"").hexdigest()}
    message = str(error)
